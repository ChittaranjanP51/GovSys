# Copy to .env and change for anything beyond a local demo.
GOVSYS_MODE=local                 # local | docker
IDENTITY_PROVIDER=local           # local | keycloak

# Postgres (local mode uses the portable cluster in data/pg on port 5433)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_SUPERPASS=govsys_admin_pw
PG_PW_AGENT_ORDER=order_pw
PG_PW_AGENT_BILLING=billing_pw
PG_PW_AGENT_ADMIN=admin_pw
PG_PW_AUDIT_WRITER=audit_pw
PG_PW_READER=reader_pw

OPA_URL=http://127.0.0.1:8181
OLLAMA_URL=http://127.0.0.1:11434
LLM_ENABLED=true
LLM_TIMEOUT_S=90

# MLflow: default is a local SQLite registry in data/mlflow.db
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Keycloak (when IDENTITY_PROVIDER=keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=govsys
KEYCLOAK_CLIENT_ID=govsys-app

# Langfuse tracing (optional; leave blank to disable)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Docker mode (docker-compose.yml). Separate DOCKER_ names so the local values
# above (127.0.0.1 addresses etc.) never leak into the containers.
# ---------------------------------------------------------------------------
DOCKER_PG_SUPERPASS=govsys_admin_pw
DOCKER_IDENTITY_PROVIDER=keycloak          # keycloak | local
DOCKER_KEYCLOAK_ADMIN_PASSWORD=admin
DOCKER_OLLAMA_URL=http://host.docker.internal:11434   # or http://ollama:11434 with the ollama profile
DOCKER_LLM_ENABLED=true
DOCKER_LANGFUSE_PUBLIC_KEY=pk-lf-govsys-local
DOCKER_LANGFUSE_SECRET_KEY=sk-lf-govsys-local
DOCKER_LANGFUSE_ADMIN_PASSWORD=govsys-admin
DOCKER_LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth
DOCKER_LANGFUSE_SALT=change-me-salt
